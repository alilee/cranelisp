; Cranelisp Ring 3 — Macros & Metaprogramming

(import [primitives [split join replace trim starts-with?]])

; What is defmacro?

defmacro

; Define a macro — quasiquote rewrites code at compile time

(defmacro twice "Evaluate and double" [x] `(+ ~x ~x))
/info twice
(twice 21)
/expand (twice (+ 1 2))

; Multi-clause macros — dispatch on argument count

(defmacro my-add "Variadic addition" ([x] x) ([x y] `(+ ~x ~y)) ([x y z] `(+ ~x (+ ~y ~z))))
/info my-add
(my-add 5)
(my-add 3 4)
(my-add 1 2 3)

; Prelude macros — case, cond, do, str

(case 3 1 "one" 2 "two" 3 "three" "other")
(cond (> 10 20) "big" (> 10 5) "medium" "small")
(str "2 + 3 = " (+ 2 3))
(str (to-upper "hello") " " (to-lower "WORLD"))

; String primitives

(split "one,two,three" ",")
(join " + " (split "one,two,three" ","))
(replace "hello world" "world" "cranelisp")
(trim "  padded  ")
(starts-with? "cranelisp" "crane")

; Threading macros — pipeline style

(defn inc [x] (+ x 1))
(defn double [x] (* x 2))
(-> 5 inc double inc)
/expand (-> 5 inc double inc)
(-> 10 (- 3))
(->> 10 (- 3))
/expand (-> 10 (- 3))
/expand (->> 10 (- 3))

; Constrained polymorphism — one def, many types

(defn describe [x] (str "the answer is " x))
(describe 42)
(describe 3.14)
(describe "everything")
