; === CLIF user::main ===
function %main() -> i64 system_v {
    gv0 = symbol userextname0
    sig0 = (i64, i64) -> i64 system_v
    sig1 = (i64) -> i64 system_v
    fn0 = u0:0 sig1

block0:
    jump block1

block1:
    v0 = iconst.i64 100
    v1 = iconst.i64 0
    v2 = global_value.i64 gv0
    v3 = iadd_imm v2, 0
    v4 = load.i64 notrap aligned v3
    v5 = call_indirect sig0, v4(v0, v1)  ; v0 = 100, v1 = 0
    v6 = iconst.i64 16
    v7 = call fn0(v6)  ; v6 = 16
    v8 = iconst.i64 0
    store notrap aligned v8, v7+16  ; v8 = 0
    store notrap aligned v5, v7+24
    return v7
}
; === end CLIF user::main ===
; === CLIF user::spin ===
function %spin(i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64):
    jump block1(v0, v1)

block1(v2: i64, v3: i64):
    v4 = iconst.i64 0
    v5 = icmp eq v2, v4  ; v4 = 0
    v6 = uextend.i64 v5
    brif v6, block2, block3

block2:
    jump block4(v3)

block3:
    v8 = iconst.i64 1
    v9 = isub.i64 v2, v8  ; v8 = 1
    v10 = iadd.i64 v3, v2
    jump block1(v9, v10)

block5:
    v11 = iconst.i64 0
    jump block4(v11)  ; v11 = 0

block4(v7: i64):
    return v7
}
; === end CLIF user::spin ===
