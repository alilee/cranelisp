; Cranelisp Ring 1 — Heap Types

"hello, world"
str-concat
(str-concat "hello" " world")

; Algebraic data types

deftype
(deftype Point [:Int x :Int y])
(Point 3 4)
(deftype (Option a) None (Some [:a val]))
(Some 42)

; Pattern matching

match
(defn get-or-zero "Extract or default to zero" [o] (match o [None 0 (Some x) x]))
get-or-zero
(get-or-zero (Some 99))
(get-or-zero None)

; Closures and higher-order functions

fn
(defn make-adder "Return a fn that adds n" [n] (fn [x] (add-i64 n x)))
make-adder
(let [add-ten (make-adder 10)] (add-ten 25))
(defn apply-twice "Apply f to x twice" [f x] (f (f x)))
apply-twice
(apply-twice (make-adder 1) 5)

; Vecs

vec-push
[1 2 3]
(vec-push [1 2] 3)

; Composing it all

(defn transform "Apply f inside Some, pass through None" [f opt] (match opt [None None (Some x) (Some (f x))]))
transform
(transform (make-adder 1) (Some 41))
(transform (make-adder 1) None)
