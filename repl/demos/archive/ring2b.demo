; Cranelisp Ring 2B — Display, User Traits, Modules

; Explore the Display trait

/sig show
(show 42)
(show true)
(show "already a string")

; String equality via the Eq trait

/sig =
(= "hello" "hello")
(= "hello" "world")

; User-defined types

deftype
(deftype Color Red Green Blue)
Color
Red
(match Green [Red "r" Green "g" Blue "b"])

; Implement Display for our type

impl
(impl Display Color (defn show [c] (match c [Red "Red" Green "Green" Blue "Blue"])))
(show Red)
(show Green)

; Constrained polymorphism — describe works on any Display type

(defn describe "Show a value as a string" [x] (str "value is " (show x)))
/sig describe
/d describe
(describe 42)
(describe true)
(describe Red)

; Constrained across Num — square works on Int and Float

(defn square "Square a number" [x] (* x x))
/sig square
(square 7)
(square 3.0)
