; Cranelisp Stdlib — What the Prelude Provides
; Traits, types, macros, and string ops from 27 stdlib modules

; === Traits power the operators — Num, Eq, Ord, Display ===

/sig +
(+ 1 2)
(+ 1.0 2.5)
(= 3 3)
(< 1 2)
(show 42)
(show 3.14)

; === Constrained polymorphism — one definition, many types ===

(defn describe [x] (str "value is " x))
(describe 42)
(describe 3.14)
(describe "hello")

; === Option and Result — safe handling via pattern matching ===

(defn get-or [opt default] (match opt [(None) default (Some x) x]))
(get-or (Some 99) 0)
(get-or None 0)
(match (Some 5) [(Some x) (str "got " x) (None) "nothing"])
(defn unwrap-or [default r] (match r [(Ok v) v (Err _) default]))
(unwrap-or 0 (Ok 42))
(unwrap-or 0 (Err "failed"))

; === str macro — build strings from any Display type ===

(str "name: " "Alice" ", age: " 30)
(str "2 + 3 = " (+ 2 3))

; === String primitives — text manipulation ===
; Text ops live in the primitives module; import them explicitly.

(import [primitives [to-upper split join replace trim contains?]])
(to-upper "hello cranelisp")
(split "alice,bob,carol" ",")
(join " and " (split "alice,bob,carol" ","))
(replace "the quick fox" "quick" "lazy")
(trim "  whitespace  ")
(contains? "cranelisp" "lisp")

; === Compose and pipeline ===

(defn inc [x] (+ x 1))
(defn double [x] (* x 2))
(defn compose [f g] (fn [x] (f (g x))))
(let [inc-then-double (compose double inc)] (inc-then-double 5))
(-> 5 inc double inc)
(join ", " (-> "hello world" (split " ")))

; === Sprint 60: named primitives in the prelude ===
; 30 Ring 0/1 primitives now ride the prelude alongside traits,
; so REPL and --run share one user surface.

/sig add-i64
(add-i64 2 3)
(mul-i64 6 7)
(str-concat "cranelisp " "lives")
(int-to-string 42)
(vec-len (vec 10 20 30))

; === Sprint 61: bare-name echo at the prompt ===
; Typing a re-exported primitive now echoes like any other Fn —
; prompt / /sig / call-site all speak the same language (spec §8.9).

add-i64
str-concat
not
