; Cranelisp Ring 2A — Traits & Operator Dispatch

; What did the prelude give us?

/imports

; Operators are trait methods

/t +
/t <
(+ 1 2)
(* 4 5)

; Same operators work on floats

3.0
(+ 1.0 2.0)

; Comparisons return Bool

(= 5 5)
(< 1 2)

; Constrained polymorphism — one definition, both types

(defn double "Multiply by 2" [x] (+ x x))
/t double
/d double
(double 5)
(double 2.5)

; Recursive with operators

(defn sum-to "Sum 1 to n" [n] (if (= n 0) 0 (+ n (sum-to (- n 1)))))
(sum-to 100)

; Define your own traits

deftrait
(deftrait (Sizeable a) (size [:a x] :Int))
(deftype Box (MkBox [:Int width :Int height]))
impl
(impl Sizeable Box (defn size [b] (match b [(MkBox w h) (* w h)])))
(size (MkBox 3 4))

; Constrained across Ord

(defn clamp "Clamp x between lo and hi" [x lo hi] (if (< x lo) lo (if (> x hi) hi x)))
/t clamp
(clamp 15 0 10)
(clamp -3 0 10)
