; Cranelisp Ring 4J — Lenient Evaluation, Auto IO Scheduling, First-Class Operators

; Sprint 25: parallelism for pure let bindings and IO chains, trait methods as values

; Lenient evaluation — independent let bindings run in parallel automatically

(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

; These bindings are independent — the compiler sparks them in parallel

(let [a (fib 25) b (fib 26)] (+ a b))

; Dependent bindings stay sequential — b uses a

(let [a (fib 20) b (+ a 1)] b)

; Cheap bindings are not worth parallelizing — cost heuristic skips them

(let [x (+ 1 2) y (+ 3 4)] (+ x y))

; CRANELISP_NO_LENIENT=1 disables automatic sparking for debugging

; Sprint 92: lenient eval widens to APPLY ARGUMENTS — independent, expensive
; arguments of one call are sparked too, so (Pair (fib a) (fib b)) runs the
; two fibs in parallel instead of serially.

(deftype Pair (Pair [:Int a :Int b]))
(defn pairfib [:Int a :Int b] (Pair (fib a) (fib b)))

; /clif surfaces the spark-budget CREATE-GATE: `call fn0(iconst 2)` is
; cranelisp_spark_budget_try_reserve(2), then `brif` forks into the lenient
; arm (ivar_create / ivar_spark / ivar_force on each arg) and the direct arm
; (sequential calls, no allocation), joining on a block param.

/clif pairfib

; Same result as a serial build — only the schedule differs (both fibs at once)

(pairfib 25 26)

; The >=2 gate holds: a single expensive argument is NOT worth sparking, so
; /clif shows NO gate — just a plain sequential call, no try_reserve, no brif.

(defn onefib [:Int a :Int b] (Pair (fib a) b))

/clif onefib

; Auto IO scheduling — commutative bind! chains run in parallel

(platform stdio)
(import [platform.stdio [print]])

; These prints are Sequential — the compiler preserves source order

(do (print "first") (print "second") (Pure 0))

; Trait methods as first-class values — operators are ordinary symbols

/sig +

; Bind an operator to a variable, then call it

(let [f +] (f 1 2))
(let [cmp <] (cmp 3 4))

; Pass operators to higher-order functions

(defn apply-both [f x y] (+ (f x 10) (f y 10)))
(apply-both + 1 2)
(apply-both * 3 4)

; Syntax highlighting — /source shows bold heads, cyan types, yellow literals, green strings

(defn greet [:String name :Int times] (if (> times 0) (str-concat "Hello " (str-concat name (str-concat "! x" (int-to-string times)))) "none"))

/source greet
(greet "world" 3)

; Verify the sprint

(defn test-lenient [] (if (= (let [a (fib 10) b (fib 11)] (+ a b)) 144) None (Some "lenient")))
(defn test-first-class-op [] (if (= (let [f +] (f 10 20)) 30) None (Some "first-class op")))
(defn test-op-passthru [] (if (= (apply-both * 3 4) 70) None (Some "op passthru")))

/run-tests
