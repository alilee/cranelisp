    participant Session as session_v4.rs (lifecycle + SharedState)
    participant Eval as eval.rs (REPL eval chain)
    participant Repl as repl.rs (slash + display)
    participant PF as process_form.rs (per-form orchestration)
    participant Worker as worker.rs (codegen batch + cache load)
    participant Sched as scheduler.rs
    participant Boot as bootstrap.rs (synthetic mount)
    participant Exp as expander.rs (macro recognition seam)
    participant FE as cranelisp-frontend
    participant TC as cranelisp-typecheck
    participant BE as cranelisp-backend (Jit / Linker)

    Caller->>Main: run / repl / link
    Main->>Session: CompilerSession::new (F-D: ~216-line fn)
    Session->>Boot: mount_synthetic_modules (F-J: register_synth_adt mirrors TC)
    Session->>Sched: spawn worker pool / register module

    alt REPL eval (eval-thread orchestrates entry module)
        Caller->>Repl: slash command / source line
        Repl->>Eval: eval (cluster boundary + :Type grouping)
        Eval->>PF: process_single_form -> process_cluster_once
        PF->>Exp: recognize_macro_head (single prelude_fallback recognition seam)
        Exp->>TC: resolve_with_fallback (prelude outer scope)
        PF->>TC: check_forms (staging#59; commit-on-Ok)
        PF->>Worker: inline_jit_codegen_for_module
        Worker->>Worker: derive_codegen_batch (F-A: scans current table ONLY#59; no prelude_fallback)
        Worker->>BE: build_session_jit / compile_to_module (F-B: JIT exported-symbol fallback)
        Repl->>Repl: lookup_with_prelude_fallback (F-G: re-inlined in describe_symbol / format_eval_result_body)
    else batch / link
        Sched->>PF: process_cluster (worker entry#59; SOLE Gap->scheduler crossing)
        PF->>FE: build_form / extract_module_declarations
        PF->>PF: drive_module_dep (single FQ-autoload drive seam)
        PF->>Worker: try_cache_hit_load (F-C: ~254-line, 9-phase god fn)
        Worker->>BE: register_binary_exported_primitives -> dlsym (F-B: Linker has NO fallback#59; hand-rolled)
        Session->>BE: compile_module_object (F-D: ~174-line) -> .o / manifest
    end

