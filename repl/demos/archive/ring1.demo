; Cranelisp Ring 1 — Heap Types

(import [primitives [str-concat add-i64 vec-push]])

"hello, world"
str-concat
(str-concat "hello" " world")

; Algebraic data types

deftype
(deftype Point [:Int x :Int y])
(Point 3 4)
(deftype (Maybe a) Nothing (Just [:a val]))
(Just 42)

; Pattern matching

match
(defn get-or-zero "Extract or default to zero" [o] (match o [Nothing 0 (Just x) x]))
get-or-zero
(get-or-zero (Just 99))
(get-or-zero Nothing)

; Closures and higher-order functions

fn
(defn make-adder "Return a fn that adds n" [n] (fn [x] (add-i64 n x)))
make-adder
(let [add-ten (make-adder 10)] (add-ten 25))
(defn apply-twice "Apply f to x twice" [f x] (f (f x)))
apply-twice
(apply-twice (make-adder 1) 5)

; Vecs

vec-push
[1 2 3]
(vec-push [1 2] 3)

; Composing it all

(defn transform "Apply f inside Just, pass through Nothing" [f opt] (match opt [Nothing Nothing (Just x) (Just (f x))]))
transform
(transform (make-adder 1) (Just 41))
(transform (make-adder 1) Nothing)
