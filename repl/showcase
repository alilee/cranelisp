#!/usr/bin/env python3
"""Showcase the Cranelisp REPL experience.

Usage:
    ./repl/showcase ring0          # build + play the Ring 0 demo
    ./repl/showcase ring1          # build + play the Ring 1 demo
    ./repl/showcase --list         # list available demos

Transparent pipe approach:
  Phase 1: Send the ENTIRE .demo file to the REPL as stdin. Capture raw output.
  Phase 2: Parse the output into (input, result) pairs by matching prompts.
           Replay with typing effects — the viewer sees exactly what the REPL
           actually produced, not a filtered reconstruction.

The showcase MUST NOT filter, reorder, or hide any REPL behavior. If comments
produce errors, blank lines produce output, or definitions show <closure> instead
of names — that is what the viewer sees. The showcase shows the product as-is.

Environment:
    DEMO_TYPING_MS         ms between characters (default: 30)
    DEMO_LINE_PAUSE_MS     ms pause before each input line (default: 1500)
    DEMO_FAST              if set, all delays are zero (CI mode)
"""

import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

REPL_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = REPL_DIR.parent
DEMOS_DIR = REPL_DIR / "demos"
RUNS_DIR = DEMOS_DIR / "runs"

FAST = os.environ.get("DEMO_FAST") is not None
TYPING_DELAY = 0 if FAST else int(os.environ.get("DEMO_TYPING_MS", "30")) / 1000.0
LINE_PAUSE = 0 if FAST else int(os.environ.get("DEMO_LINE_PAUSE_MS", "1500")) / 1000.0

DIM = "\033[90m"
BOLD = "\033[1m"
RESET = "\033[0m"


def list_demos():
    demos = sorted(DEMOS_DIR.glob("*.demo"))
    if not demos:
        print("No demos found.")
        return
    print(f"{BOLD}Available demos:{RESET}")
    for d in demos:
        desc = ""
        with open(d) as f:
            for line in f:
                if line.startswith(";"):
                    desc = line.lstrip("; ").strip()
                    break
        print(f"  {d.stem:20s} {DIM}{desc}{RESET}")


def build_binary():
    print(f"{DIM}; building cranelisp...{RESET}")
    sys.stdout.flush()
    result = subprocess.run(
        ["cargo", "build", "--quiet"],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"Build failed:\n{result.stderr}", file=sys.stderr)
        sys.exit(1)
    binary = PROJECT_ROOT / "target" / "debug" / "cranelisp"
    if not binary.exists():
        print(f"Binary not found at {binary}", file=sys.stderr)
        sys.exit(1)
    return str(binary)


def run_demo(demo_path, repl_binary, run_dir):
    """Send the entire .demo file to the REPL and capture raw output.

    Returns the raw stdout from the REPL process. No filtering, no
    reordering — the REPL sees comments, blank lines, and expressions
    exactly as written in the .demo file.
    """
    with open(demo_path) as f:
        demo_text = f.read()

    result = subprocess.run(
        [repl_binary],
        input=demo_text,
        capture_output=True,
        text=True,
        cwd=run_dir,
    )

    return result.stdout


def parse_repl_output(demo_text, raw_output):
    """Parse raw REPL output into (input_line, result_lines) pairs.

    The REPL writes "> " (no newline) for each input line, then prints
    any result followed by a newline. In piped mode this means:
    - No-output lines (comments, blanks): consecutive "> " prompts
    - Result lines: "> " prompt followed by result text on the same line
    - Multi-line results: result continues on subsequent lines until next "> "

    We split on "> " boundaries to recover which result goes with which input.
    """
    input_lines = demo_text.splitlines()

    # Split raw output on "> " prompt markers.
    # The REPL always starts with "> ", so the first segment is empty.
    segments = raw_output.split("> ")

    pairs = []
    for i, input_line in enumerate(input_lines):
        # Segment i+1 corresponds to input line i (segment 0 is before first prompt).
        seg_idx = i + 1
        result = None
        if seg_idx < len(segments):
            content = segments[seg_idx].strip()
            if content:
                result = content
        pairs.append((input_line, result))

    return pairs


def type_line(text):
    """Write text character-by-character with typing delay."""
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(TYPING_DELAY)


def replay(pairs):
    """Replay the demo, showing exactly what the user would see at the REPL.

    Every input line is typed at the prompt. The REPL's actual response
    (or silence) follows. No special treatment for comments or blanks —
    the viewer sees exactly the user experience.
    """
    for input_line, result in pairs:
        time.sleep(LINE_PAUSE)
        sys.stdout.write("> ")
        sys.stdout.flush()
        stripped = input_line.strip()
        if stripped == "" or stripped.startswith(";"):
            # Comments and blank lines: print instantly (nothing to learn from typing them)
            sys.stdout.write(input_line + "\n")
        else:
            type_line(input_line)
            sys.stdout.write("\n")
        sys.stdout.flush()
        if result is not None:
            print(result)


def play_demo(demo_path, repl_binary):
    # Create timestamped run directory for cache isolation.
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    demo_name = Path(demo_path).stem
    timestamp = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    run_dir = RUNS_DIR / f"{timestamp}_{demo_name}"
    run_dir.mkdir()

    print(f"{DIM}; run dir: {run_dir}{RESET}\n")
    sys.stdout.flush()

    # Phase 1: send entire demo file to REPL, capture raw output.
    with open(demo_path) as f:
        demo_text = f.read()

    raw_output = run_demo(demo_path, repl_binary, run_dir)

    # Phase 2: parse and replay with typing effects.
    pairs = parse_repl_output(demo_text, raw_output)
    replay(pairs)

    print(f"\n{DIM}; [demo complete]{RESET}")


def main():
    args = sys.argv[1:]

    if not args or "--help" in args or "-h" in args:
        print("Usage: ./repl/showcase [--list] <demo-name>")
        print("       ./repl/showcase ring0")
        print("       ./repl/showcase --list")
        sys.exit(0)

    if "--list" in args:
        list_demos()
        sys.exit(0)

    demo_name = args[0]
    demo_path = DEMOS_DIR / f"{demo_name}.demo"
    if not demo_path.exists():
        print(f"Error: {demo_path} not found")
        list_demos()
        sys.exit(1)

    repl_binary = build_binary()
    play_demo(demo_path, repl_binary)


if __name__ == "__main__":
    main()
