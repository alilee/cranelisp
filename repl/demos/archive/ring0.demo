; Cranelisp Ring 0 — Core Language

; The raw integer primitives live in the `primitives` module. Import the ones
; this tour uses; the curated prelude wraps these behind the operators + - * = <.

(import [primitives [add-i64 sub-i64 mul-i64 eq-i64 lt-i64 not]])

add-i64
(add-i64 2 3)
(sub-i64 10 4)
(mul-i64 6 7)

; Booleans

true
(eq-i64 3 3)
(lt-i64 2 5)
(not true)

; Let bindings

let
(let [x 10] (let [y 20] (add-i64 x y)))

; Defining functions

defn
(defn double "Multiply by two" [x] (mul-i64 x 2))
double
(double 21)

; Conditionals

if
(defn abs "Absolute value" [n] (if (lt-i64 n 0) (sub-i64 0 n) n))
abs
(abs -42)

; Recursion with tail-call optimisation

(defn factorial [n] (if (eq-i64 n 0) 1 (mul-i64 n (factorial (sub-i64 n 1)))))
(factorial 10)

(defn sum-acc [n acc] (if (eq-i64 n 0) acc (sum-acc (sub-i64 n 1) (add-i64 acc n))))
(sum-acc 1000000 0)
