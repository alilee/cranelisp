; Cranelisp Stdlib Progress — Prelude in Action

; === Arithmetic via Num — Int and Float dispatch ===
(+ 1 2)
(* 4 5)
(+ 1.5 2.5)
(* 3.0 0.5)

; === Comparison via Eq and Ord ===
(= 1 1)
(< 1 2)
(!= "hello" "world")

; === Display trait — show converts values to String ===
(show 42)
(show 3.14)
(str-concat "value: " (show true))

; === Constrained polymorphism — one definition, many types ===
(defn describe [x] (str-concat "value is " (show x)))
(describe 42)
(describe 3.14)

; === Option type — safe handling of missing values ===
(Some 42)
None
(defn get-or [opt default] (match opt [None default (Some x) x]))
(get-or (Some 99) 0)
(get-or None 0)

; === Macros: do, cond, def ===
(do (+ 1 2) (* 3 4))
(cond (= 1 1) 42 (= 1 2) 99 0)
(def answer 42)
(+ answer 1)

; === Threading macro — pipeline style ===
(defn inc [x] (+ x 1))
(defn double [x] (* x 2))
(-> 5 inc double)
/expand (-> 5 inc double)

; === Putting it all together ===
(defn square [x] (* x x))
(square 7)
(square 3.0)
(defn max [a b] (if (> a b) a b))
(max 10 20)
(max 3.14 2.72)
(defn factorial [n] (if (= n 0) 1 (* n (factorial (- n 1)))))
(factorial 10)

; 50 prelude names ready — traits, types, and macros
/list
