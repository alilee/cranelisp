    jump block1(v0, v1, v2)

block1(v3: i64, v4: i64, v5: i64):
    v6 = iadd v4, v5
    v7 = iadd v3, v6
    return v7
}
; === end CLIF user::add3 ===
; === CLIF user::main ===
