; Cranelisp Ring 4K — Stateless TypeChecker, FQTypeName

; Sprint 51: types carry their module, registries eliminated

; Define a user type — it lives in user/

(deftype (Pair a b) (MkPair [:a fst :b snd]))

(MkPair 1 true)

; Types display with module-qualified names

(deftype Color Red Green Blue)

(defn color-name [c] (match c [Color.Red "red" Color.Green "green" Color.Blue "blue"]))

(color-name Color.Blue)

; Accessors work on product types

(fst (MkPair 42 false))

; Nested ADTs

(deftype (Box a) (MkBox [:a inside]))

(MkBox (MkPair 1 2))

; Pattern matching composes

(defn unbox [b] (match b [(MkBox x) x]))

(fst (unbox (MkBox (MkPair 99 0))))
