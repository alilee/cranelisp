; Cranelisp Ring 4D — Developer Tools & Panic Exit

(import [primitives [div-i64]])

; Define a function to inspect

(defn factorial [n] (if (= n 0) 1 (* n (factorial (- n 1)))))

; /source shows the original source text

/source factorial

; /clif shows the Cranelift IR — the actual compiled code

/clif factorial

; The inspected function runs normally.

(factorial 6)
(+ 1 2)

; Division by zero reports a panic and exits the REPL.

(div-i64 1 0)
