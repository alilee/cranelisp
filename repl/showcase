#!/usr/bin/env python3
"""Showcase the Cranelisp REPL experience.

Usage:
    ./repl/showcase ring0          # build + play the Ring 0 demo
    ./repl/showcase ring1          # build + play the Ring 1 demo
    ./repl/showcase --list         # list available demos

Transparent pipe approach:
  Phase 1: Send the ENTIRE .demo file to the REPL as stdin. Capture raw output.
  Phase 2: Parse the output into (input, result) pairs by matching prompts.
           Replay with typing effects — the viewer sees exactly what the REPL
           actually produced, not a filtered reconstruction.

The showcase MUST NOT filter, reorder, or hide any REPL behavior. If comments
produce errors, blank lines produce output, or definitions show <closure> instead
of names — that is what the viewer sees. The showcase shows the product as-is.

Environment:
    DEMO_TYPING_MS         ms between characters (default: 30)
    DEMO_LINE_PAUSE_MS     ms pause before each input line (default: 1500)
    DEMO_FAST              if set, all delays are zero (CI mode)
"""

import os
import re
import select
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime
from pathlib import Path

REPL_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = REPL_DIR.parent
DEMOS_DIR = REPL_DIR / "demos"
RUNS_DIR = DEMOS_DIR / "runs"

FAST = os.environ.get("DEMO_FAST") is not None
TYPING_DELAY = 0 if FAST else int(os.environ.get("DEMO_TYPING_MS", "30")) / 1000.0
LINE_PAUSE = 0 if FAST else int(os.environ.get("DEMO_LINE_PAUSE_MS", "1500")) / 1000.0

DIM = "\033[90m"
BOLD = "\033[1m"
RESET = "\033[0m"


def list_demos():
    demos = sorted(DEMOS_DIR.glob("*.demo"))
    if not demos:
        print("No demos found.")
        return
    print(f"{BOLD}Available demos:{RESET}")
    for d in demos:
        desc = ""
        with open(d) as f:
            for line in f:
                if line.startswith(";"):
                    desc = line.lstrip("; ").strip()
                    break
        print(f"  {d.stem:20s} {DIM}{desc}{RESET}")


def build_binary():
    print(f"{DIM}; building cranelisp...{RESET}")
    sys.stdout.flush()
    result = subprocess.run(
        ["cargo", "build", "--quiet"],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"Build failed:\n{result.stderr}", file=sys.stderr)
        sys.exit(1)
    binary = PROJECT_ROOT / "target" / "debug" / "cranelisp"
    if not binary.exists():
        print(f"Binary not found at {binary}", file=sys.stderr)
        sys.exit(1)
    return str(binary)


def run_demo(demo_path, repl_binary, run_dir):
    """Send the entire .demo file to the REPL and capture raw output.

    Returns the raw stdout from the REPL process. No filtering, no
    reordering — the REPL sees comments, blank lines, and expressions
    exactly as written in the .demo file.
    """
    with open(demo_path) as f:
        demo_text = f.read()

    env = os.environ.copy()
    env["CRANELISP_LIB"] = str(REPL_DIR / "demos" / "lib")

    result = subprocess.run(
        [repl_binary],
        input=demo_text,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        cwd=run_dir,
        env=env,
    )

    # Stderr carries traces and diagnostic output — include it after stdout.
    if result.stderr:
        sys.stderr.write(f"{DIM}{result.stderr}{RESET}")
        sys.stderr.flush()

    return result.stdout


def parse_repl_output(demo_text, raw_output):
    """Parse raw REPL output into (prompt, input_line, result_lines) triples.

    The REPL prompt has the form "N+Nms; module> " (e.g., "0+0ms; user> ").
    We split on this pattern to correctly recover which result goes with which
    input, and capture the prompt text for faithful replay.
    """
    input_lines = demo_text.splitlines()

    # Split on the REPL prompt pattern, capturing the prompt itself.
    # This matches prompts like "0+0ms; user> ", "4+0ms; user> ", etc.
    prompt_re = re.compile(r"(\d+\+\d+ms; \w+> )")
    parts = prompt_re.split(raw_output)

    # parts alternates: [before_first_prompt, prompt1, result1, prompt2, result2, ...]
    # Extract prompts and results as parallel lists.
    prompts = []
    segments = []
    for j in range(1, len(parts), 2):
        prompts.append(parts[j])
        if j + 1 < len(parts):
            segments.append(parts[j + 1])
        else:
            segments.append("")

    triples = []
    for i, input_line in enumerate(input_lines):
        prompt = prompts[i] if i < len(prompts) else "? "
        result = None
        if i < len(segments):
            content = segments[i].strip()
            if content:
                result = content
        triples.append((prompt, input_line, result))

    return triples


def check_key():
    """Check for keypress without blocking. Returns the key or None."""
    if FAST or not sys.stdin.isatty():
        return None
    ready, _, _ = select.select([sys.stdin], [], [], 0)
    if ready:
        return sys.stdin.read(1)
    return None


def interruptible_sleep(seconds):
    """Sleep that can be interrupted by spacebar (pause) or q (quit).

    Returns True to continue, False to quit.
    """
    if FAST or seconds <= 0:
        return True
    end = time.time() + seconds
    while time.time() < end:
        key = check_key()
        if key == "q":
            return False
        if key == " ":
            # Paused — wait for another space or q.
            sys.stdout.write(f"{DIM}[paused]{RESET}")
            sys.stdout.flush()
            while True:
                ch = sys.stdin.read(1)
                if ch == " ":
                    # Clear the [paused] indicator.
                    sys.stdout.write("\r" + " " * 8 + "\r")
                    sys.stdout.flush()
                    break
                if ch == "q":
                    sys.stdout.write("\r" + " " * 8 + "\r")
                    sys.stdout.flush()
                    return False
        # FIXME(/repl): interruptible_sleep can produce negative durations when
        # the loop overshoots the deadline. Clamped to 0 as a band-aid — review
        # the timing logic for robustness.
        time.sleep(max(0, min(0.05, end - time.time())))
    return True


def type_line(text):
    """Write text character-by-character with typing delay.

    Returns True to continue, False if user pressed q.
    """
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        if not interruptible_sleep(TYPING_DELAY):
            return False
    return True


def replay(triples):
    """Replay the demo, showing exactly what the user would see at the REPL.

    Every input line is typed at the prompt. The REPL's actual response
    (or silence) follows. No special treatment for comments or blanks —
    the viewer sees exactly the user experience.

    Press spacebar to pause/unpause, q to quit.
    """
    # Set terminal to raw mode for keypress detection.
    is_tty = sys.stdin.isatty() and not FAST
    if is_tty:
        old_attrs = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())

    try:
        for prompt, input_line, result in triples:
            if not interruptible_sleep(LINE_PAUSE):
                break
            sys.stdout.write(prompt)
            sys.stdout.flush()
            stripped = input_line.strip()
            if stripped == "" or stripped.startswith(";"):
                sys.stdout.write(input_line + "\n")
            else:
                if not type_line(input_line):
                    sys.stdout.write("\n")
                    break
                sys.stdout.write("\n")
            sys.stdout.flush()
            if result is not None:
                print(result)
    finally:
        if is_tty:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_attrs)


def play_demo(demo_path, repl_binary):
    # Create timestamped run directory for cache isolation.
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    demo_name = Path(demo_path).stem
    timestamp = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    run_dir = RUNS_DIR / f"{timestamp}_{demo_name}"
    run_dir.mkdir()

    print(f"{DIM}; run dir: {run_dir}{RESET}")
    if not FAST and sys.stdin.isatty():
        print(f"{DIM}; [space] pause/unpause, [q] quit{RESET}")
    print()
    sys.stdout.flush()

    # Phase 1: send entire demo file to REPL, capture raw output.
    with open(demo_path) as f:
        demo_text = f.read()

    raw_output = run_demo(demo_path, repl_binary, run_dir)

    # Phase 2: parse and replay with typing effects.
    triples = parse_repl_output(demo_text, raw_output)
    replay(triples)

    print(f"\n{DIM}; [demo complete]{RESET}")


def main():
    args = sys.argv[1:]

    if not args or "--help" in args or "-h" in args:
        print("Usage: ./repl/showcase [--list] <demo-name>")
        print("       ./repl/showcase ring0")
        print("       ./repl/showcase --list")
        sys.exit(0)

    if "--list" in args:
        list_demos()
        sys.exit(0)

    demo_name = args[0]
    demo_path = DEMOS_DIR / f"{demo_name}.demo"
    if not demo_path.exists():
        print(f"Error: {demo_path} not found")
        list_demos()
        sys.exit(1)

    repl_binary = build_binary()
    play_demo(demo_path, repl_binary)


if __name__ == "__main__":
    main()
