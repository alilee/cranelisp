#!/usr/bin/env python3
"""Showcase the Cranelisp REPL experience.

Usage:
    ./repl/showcase tour           # build + play the tour demo (bare name)
    ./repl/showcase 01-tour        # same demo, full numbered name
    ./repl/showcase sudoku         # build + play the Sudoku demo
    ./repl/showcase ring4s         # build + play an archived guard
    ./repl/showcase --list         # list the active set (guided order) + guards

Delegates to demo-player.py for live PTY-based playback. The showcase
handles building the binary, setting up the environment, creating the
run directory, and then hands off to the demo player which types each
line character-by-character into a real REPL process.

The showcase MUST NOT filter, reorder, or hide any REPL behavior. The
viewer sees exactly what the REPL actually produces, live.

Environment:
    DEMO_TYPING_MS         ms between characters (default: 30)
    DEMO_LINE_PAUSE_MS     ms pause after REPL response (default: 1500)
    DEMO_COMMENT_PAUSE_MS  ms after comment display (default: 800)
    DEMO_FAST              if set, all delays are zero (CI mode)
"""

import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

REPL_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = REPL_DIR.parent
DEMOS_DIR = REPL_DIR / "demos"
RUNS_DIR = DEMOS_DIR / "runs"
DEMO_PLAYER = DEMOS_DIR / "demo-player.py"

FAST = os.environ.get("DEMO_FAST") is not None

DIM = "\033[90m"
BOLD = "\033[1m"
RESET = "\033[0m"


def _first_comment(path):
    """Return the first comment line of a .demo as its description."""
    with open(path) as f:
        for line in f:
            if line.startswith(";"):
                return line.lstrip("; ").strip()
    return ""


def _print_demo_row(path):
    print(f"  {path.stem:20s} {DIM}{_first_comment(path)}{RESET}")


def resolve_active(demo_name):
    """Resolve a demo name against the active set.

    Active demos are numbered (NN-name.demo) so the alphabetical sort
    coincides with the pedagogical order. A viewer may invoke either the
    full numbered stem (01-tour) or the bare name (tour) — both resolve to
    the same file. Returns the path or None.
    """
    # Exact stem match first (full numbered name, e.g. 01-tour).
    exact = DEMOS_DIR / f"{demo_name}.demo"
    if exact.exists():
        return exact
    # Bare-name match: strip the NN- prefix and compare the suffix.
    for d in sorted(DEMOS_DIR.glob("*.demo")):
        stem = d.stem
        suffix = stem.split("-", 1)[1] if stem[:2].isdigit() and "-" in stem else stem
        if suffix == demo_name:
            return d
    return None


def list_demos():
    active = sorted(DEMOS_DIR.glob("*.demo"))
    archived = sorted((DEMOS_DIR / "archive").glob("**/*.demo"))
    if not active and not archived:
        print("No demos found.")
        return
    print(f"{BOLD}Guided order (watch top-to-bottom):{RESET}")
    for d in active:
        _print_demo_row(d)
    if archived:
        print()
        print(f"{BOLD}Archived (regression guards):{RESET}")
        for d in archived:
            _print_demo_row(d)


def build_binary():
    print(f"{DIM}; building cranelisp...{RESET}")
    sys.stdout.flush()
    result = subprocess.run(
        ["cargo", "build", "--quiet"],
        cwd=PROJECT_ROOT,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"Build failed:\n{result.stderr}", file=sys.stderr)
        sys.exit(1)
    binary = PROJECT_ROOT / "target" / "debug" / "cranelisp"
    if not binary.exists():
        print(f"Binary not found at {binary}", file=sys.stderr)
        sys.exit(1)
    return str(binary)


def make_demo_env():
    """Build the environment for running the REPL in demo mode."""
    env = os.environ.copy()
    # Use real stdlib for prelude and domain modules.
    env["CRANELISP_LIB"] = str(PROJECT_ROOT / "stdlib")
    # Platform DLLs live in target/debug/ during development.
    env["CRANELISP_PLATFORM_PATH"] = str(PROJECT_ROOT / "target" / "debug")
    return env


def play_demo(demo_path, repl_binary):
    # Create timestamped run directory for cache isolation.
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    demo_name = Path(demo_path).stem
    timestamp = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    run_dir = RUNS_DIR / f"{timestamp}_{demo_name}"
    run_dir.mkdir()

    env = make_demo_env()

    # Show a copyable run command so the viewer can reproduce the session.
    lib_rel = str(Path(env["CRANELISP_LIB"]).relative_to(PROJECT_ROOT))
    platform_rel = str(Path(env["CRANELISP_PLATFORM_PATH"]).relative_to(PROJECT_ROOT))
    print(f"{DIM}; CRANELISP_LIB={lib_rel} CRANELISP_PLATFORM_PATH={platform_rel} cargo run{RESET}")
    print(f"{DIM}; run dir: {run_dir}{RESET}")
    if not FAST and sys.stdin.isatty():
        print(f"{DIM}; [space] pause/unpause, [q] quit{RESET}")
    print()
    sys.stdout.flush()

    # Delegate to demo-player.py for live PTY-based playback.
    result = subprocess.run(
        [
            sys.executable,
            str(DEMO_PLAYER),
            str(demo_path),
            repl_binary,
            "--run-dir",
            str(run_dir),
        ],
        env=env,
    )
    sys.exit(result.returncode)


def main():
    args = sys.argv[1:]

    if not args or "--help" in args or "-h" in args:
        print("Usage: ./repl/showcase [--list] <demo-name>")
        print("       ./repl/showcase tour        # bare name, or 01-tour")
        print("       ./repl/showcase sudoku")
        print("       ./repl/showcase --list")
        sys.exit(0)

    if "--list" in args:
        list_demos()
        sys.exit(0)

    demo_name = args[0]
    # Resolve against the active set first (full numbered name OR bare name —
    # `01-tour` and `tour` both resolve), then fall back to the archive/ guards.
    demo_path = resolve_active(demo_name)
    if demo_path is None:
        archived = DEMOS_DIR / "archive" / f"{demo_name}.demo"
        if archived.exists():
            demo_path = archived
        else:
            print(f"Error: {demo_name}.demo not found (looked in demos/ and demos/archive/)")
            list_demos()
            sys.exit(1)

    repl_binary = build_binary()
    play_demo(demo_path, repl_binary)


if __name__ == "__main__":
    main()
